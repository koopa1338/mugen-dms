# SurrealDB connection
# Remote server (docker-compose):
DATABASE_URL=ws://localhost:8000
DB_USER=root
DB_PASS=root

# Embedded RocksDB (no separate process, dev/single-node):
# DATABASE_URL=rocksdb://./data/mugen

# In-memory (tests / CI):
# DATABASE_URL=mem://

# Filesystem storage root
STORAGE_ROOT=./storage

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-in-production

# Path to the logging.toml config file
LOGGING=./logging.toml

# Scanner cron interval in seconds
SCANNER_INTERVAL=30
